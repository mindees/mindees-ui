{
  "name": "@mindees/icons",
  "version": "1.2.0",
  "description": "Tree-shakeable SVG icon library for React Native and Expo, built on react-native-svg. Every icon is a named export; New Architecture ready; iOS, Android, and React Native Web.",
  "keywords": [
    "react-native-icons",
    "react-native-svg-icons",
    "expo-icons",
    "svg-icon-library",
    "icon-component",
    "icons",
    "icon-set",
    "vector-icons",
    "scalable-icons",
    "tree-shakeable",
    "tree-shakeable-icons",
    "named-exports",
    "react-native-svg",
    "cross-platform-icons",
    "ios",
    "android",
    "react-native-web",
    "typescript",
    "strict-types",
    "new-architecture",
    "fabric",
    "jsi",
    "custom-icons",
    "createicon",
    "ui-icons",
    "react-native",
    "expo",
    "mindees",
    "mindees-ui"
  ],
  "license": "MIT",
  "homepage": "https://mindees-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindees/mindees-ui.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/mindees/mindees-ui/issues"
  },
  "sideEffects": false,
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "clean": "rm -rf lib .turbo"
  },
  "peerDependencies": {
    "react": ">=19.1.0",
    "react-native": ">=0.83.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.15",
    "react": "19.2.6",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.41.0",
    "react-native-svg": "~15.15.5",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
