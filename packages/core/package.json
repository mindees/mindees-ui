{
  "name": "@mindees/ui",
  "version": "0.0.1",
  "description": "Universal React Native CLI + Expo component library with a deterministic Layout Intelligence Layer.",
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "components",
    "design-system",
    "new-architecture",
    "fabric",
    "unistyles",
    "layout-intelligence",
    "accessibility",
    "a11y"
  ],
  "homepage": "https://mindees.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindees/mindees-ui.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "sideEffects": false,
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./theme": {
      "react-native": "./src/theme/index.ts",
      "import": {
        "types": "./lib/typescript/module/theme/index.d.ts",
        "default": "./lib/module/theme/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/theme/index.d.ts",
        "default": "./lib/commonjs/theme/index.js"
      }
    },
    "./layout-intelligence": {
      "react-native": "./src/layout-intelligence/index.ts",
      "import": {
        "types": "./lib/typescript/module/layout-intelligence/index.d.ts",
        "default": "./lib/module/layout-intelligence/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/layout-intelligence/index.d.ts",
        "default": "./lib/commonjs/layout-intelligence/index.js"
      }
    },
    "./providers": {
      "react-native": "./src/providers/index.ts",
      "import": {
        "types": "./lib/typescript/module/providers/index.d.ts",
        "default": "./lib/module/providers/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/providers/index.d.ts",
        "default": "./lib/commonjs/providers/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/*.test.{ts,tsx}",
    "!**/*.spec.{ts,tsx}"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:perf": "reassure",
    "clean": "rm -rf lib .turbo coverage .reassure"
  },
  "dependencies": {
    "@mindees/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.1.0",
    "react-native": ">=0.83.0",
    "react-native-edge-to-edge": "*",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-nitro-modules": "*",
    "react-native-reanimated": ">=4.0.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-svg": ">=15.0.0",
    "react-native-unistyles": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@gorhom/bottom-sheet": {
      "optional": true
    },
    "@shopify/flash-list": {
      "optional": true
    },
    "expo-blur": {
      "optional": true
    },
    "expo-camera": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "expo-image": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@callstack/reassure-cli": "^1.4.1",
    "@react-native/babel-preset": "^0.85.3",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.15",
    "jest": "^29.7.0",
    "react": "19.2.6",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.41.0",
    "react-test-renderer": "19.2.6",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?(react-native|@react-native|react-native-.*|@react-navigation|jest-runtime)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/**/__fixtures__/**",
      "!src/**/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
