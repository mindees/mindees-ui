{
  "name": "@mindees/ui",
  "version": "1.0.1",
  "description": "Universal React Native CLI + Expo component library with a deterministic Layout Intelligence Layer.",
  "keywords": [
    "react-native",
    "react-native-ui",
    "react-native-components",
    "react-native-ui-library",
    "react-native-ui-kit",
    "react-native-design-system",
    "react-native-web",
    "expo",
    "expo-ui",
    "expo-sdk-55",
    "expo-sdk-56",
    "expo-router",
    "universal-components",
    "cross-platform",
    "ios",
    "android",
    "web",
    "ui",
    "ui-library",
    "ui-kit",
    "ui-components",
    "components",
    "component-library",
    "design-system",
    "design-tokens",
    "theming",
    "dark-mode",
    "high-contrast",
    "new-architecture",
    "fabric",
    "jsi",
    "turbomodules",
    "bridgeless",
    "react-19",
    "typescript",
    "strict-typescript",
    "unistyles",
    "react-native-unistyles",
    "react-native-reanimated",
    "react-native-gesture-handler",
    "flash-list",
    "shopify-flash-list",
    "layout-intelligence",
    "auto-layout",
    "intrinsic-sizing",
    "auto-spacing",
    "compound-components",
    "slot",
    "as-child",
    "radix-slot",
    "child-introspection",
    "polymorphic-components",
    "accessibility",
    "a11y",
    "wcag",
    "wcag-2-2",
    "rtl",
    "right-to-left",
    "dynamic-type",
    "prefers-reduced-motion",
    "screen-reader",
    "haptics",
    "mobile-ui",
    "mobile-components",
    "mindees",
    "mindees-ui"
  ],
  "homepage": "https://mindees-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindees/mindees-ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mindees/mindees-ui/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./theme": {
      "react-native": "./src/theme/index.ts",
      "import": {
        "types": "./lib/typescript/module/theme/index.d.ts",
        "default": "./lib/module/theme/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/theme/index.d.ts",
        "default": "./lib/commonjs/theme/index.js"
      }
    },
    "./layout-intelligence": {
      "react-native": "./src/layout-intelligence/index.ts",
      "import": {
        "types": "./lib/typescript/module/layout-intelligence/index.d.ts",
        "default": "./lib/module/layout-intelligence/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/layout-intelligence/index.d.ts",
        "default": "./lib/commonjs/layout-intelligence/index.js"
      }
    },
    "./providers": {
      "react-native": "./src/providers/index.ts",
      "import": {
        "types": "./lib/typescript/module/providers/index.d.ts",
        "default": "./lib/module/providers/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/providers/index.d.ts",
        "default": "./lib/commonjs/providers/index.js"
      }
    },
    "./styling": {
      "react-native": "./src/styling/index.ts",
      "import": {
        "types": "./lib/typescript/module/styling/index.d.ts",
        "default": "./lib/module/styling/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/styling/index.d.ts",
        "default": "./lib/commonjs/styling/index.js"
      }
    },
    "./a11y": {
      "react-native": "./src/a11y/index.ts",
      "import": {
        "types": "./lib/typescript/module/a11y/index.d.ts",
        "default": "./lib/module/a11y/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/a11y/index.d.ts",
        "default": "./lib/commonjs/a11y/index.js"
      }
    },
    "./components": {
      "react-native": "./src/components/index.ts",
      "import": {
        "types": "./lib/typescript/module/components/index.d.ts",
        "default": "./lib/module/components/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/components/index.d.ts",
        "default": "./lib/commonjs/components/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/*.test.{ts,tsx}",
    "!**/*.spec.{ts,tsx}"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:perf": "reassure measure",
    "clean": "rm -rf lib .turbo coverage .reassure"
  },
  "dependencies": {
    "@mindees/icons": "workspace:*",
    "@mindees/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.1.0",
    "react-native": ">=0.83.0",
    "react-native-edge-to-edge": "*",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-nitro-modules": "*",
    "react-native-reanimated": ">=4.0.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-svg": ">=15.0.0",
    "react-native-unistyles": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@gorhom/bottom-sheet": {
      "optional": true
    },
    "@shopify/flash-list": {
      "optional": true
    },
    "expo-blur": {
      "optional": true
    },
    "expo-camera": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "expo-image": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.85.3",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.15",
    "jest": "^29.7.0",
    "react": "19.2.6",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.41.0",
    "react-test-renderer": "19.2.6",
    "reassure": "^1.4.1",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?(react-native|@react-native|react-native-.*|@react-navigation|jest-runtime)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/**/__fixtures__/**",
      "!src/**/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 25,
        "functions": 20,
        "lines": 35,
        "statements": 35
      }
    }
  }
}
