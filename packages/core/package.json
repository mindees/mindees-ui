{
  "name": "@mindees/ui",
  "version": "0.0.1",
  "description": "Universal React Native CLI + Expo component library with a deterministic Layout Intelligence Layer.",
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "components",
    "design-system",
    "new-architecture",
    "fabric",
    "unistyles",
    "layout-intelligence",
    "accessibility",
    "a11y"
  ],
  "homepage": "https://mindees.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindees/mindees-ui.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "sideEffects": false,
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./theme": {
      "types": "./lib/typescript/src/theme/index.d.ts",
      "react-native": "./src/theme/index.ts",
      "import": "./lib/module/theme/index.js",
      "require": "./lib/commonjs/theme/index.js"
    },
    "./layout-intelligence": {
      "types": "./lib/typescript/src/layout-intelligence/index.d.ts",
      "react-native": "./src/layout-intelligence/index.ts",
      "import": "./lib/module/layout-intelligence/index.js",
      "require": "./lib/commonjs/layout-intelligence/index.js"
    },
    "./providers": {
      "types": "./lib/typescript/src/providers/index.d.ts",
      "react-native": "./src/providers/index.ts",
      "import": "./lib/module/providers/index.js",
      "require": "./lib/commonjs/providers/index.js"
    }
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/*.test.{ts,tsx}",
    "!**/*.spec.{ts,tsx}"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:perf": "reassure",
    "clean": "rm -rf lib .turbo coverage .reassure"
  },
  "dependencies": {
    "@mindees/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.1.0",
    "react-native": ">=0.83.0",
    "react-native-edge-to-edge": "*",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-nitro-modules": "*",
    "react-native-reanimated": ">=4.0.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-svg": ">=15.0.0",
    "react-native-unistyles": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@gorhom/bottom-sheet": { "optional": true },
    "@shopify/flash-list": { "optional": true },
    "expo-blur": { "optional": true },
    "expo-camera": { "optional": true },
    "expo-haptics": { "optional": true },
    "expo-image": { "optional": true },
    "expo-image-picker": { "optional": true }
  },
  "devDependencies": {
    "@callstack/reassure-cli": "^1.4.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.1",
    "@types/react-native": "^0.73.0",
    "jest": "^29.7.0",
    "react": "19.1.0",
    "react-native": "0.83.0",
    "react-native-builder-bob": "^0.41.0",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      ["commonjs", { "esm": true }],
      ["module", { "esm": true }],
      ["typescript", { "project": "tsconfig.build.json", "esm": true }]
    ]
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEach": ["<rootDir>/jest.setup.ts"],
    "testPathIgnorePatterns": ["/node_modules/", "/lib/"],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-.*|@react-navigation)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/**/__fixtures__/**",
      "!src/**/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
