{
  "name": "@mindees/tokens",
  "version": "1.0.0",
  "description": "Design tokens for React Native and Expo — colour scales (semantic + high-contrast), typography, spacing, radii, shadows, motion, breakpoints, z-index, density. The foundation of MindeesUI, usable on its own.",
  "keywords": [
    "design-tokens",
    "react-native-design-tokens",
    "expo-design-tokens",
    "design-system",
    "color-tokens",
    "color-scales",
    "semantic-colors",
    "radix-colors",
    "high-contrast",
    "accessibility",
    "wcag",
    "typography",
    "typography-scale",
    "modular-scale",
    "type-scale",
    "spacing",
    "spacing-scale",
    "4-point-grid",
    "radii",
    "border-radius",
    "shadows",
    "cross-platform-shadows",
    "ios-shadow",
    "android-elevation",
    "motion",
    "easing-curves",
    "duration",
    "breakpoints",
    "responsive",
    "z-index",
    "stacking-context",
    "density",
    "theming",
    "dark-mode",
    "light-mode",
    "brand-themes",
    "react-native",
    "react-native-web",
    "expo",
    "typescript",
    "tree-shakeable",
    "subpath-exports",
    "mindees",
    "mindees-ui"
  ],
  "license": "MIT",
  "homepage": "https://mindees-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindees/mindees-ui.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/mindees/mindees-ui/issues"
  },
  "sideEffects": false,
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./color": {
      "react-native": "./src/color.ts",
      "import": {
        "types": "./lib/typescript/module/color.d.ts",
        "default": "./lib/module/color.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/color.d.ts",
        "default": "./lib/commonjs/color.js"
      }
    },
    "./typography": {
      "react-native": "./src/typography.ts",
      "import": {
        "types": "./lib/typescript/module/typography.d.ts",
        "default": "./lib/module/typography.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/typography.d.ts",
        "default": "./lib/commonjs/typography.js"
      }
    },
    "./spacing": {
      "react-native": "./src/spacing.ts",
      "import": {
        "types": "./lib/typescript/module/spacing.d.ts",
        "default": "./lib/module/spacing.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/spacing.d.ts",
        "default": "./lib/commonjs/spacing.js"
      }
    },
    "./radii": {
      "react-native": "./src/radii.ts",
      "import": {
        "types": "./lib/typescript/module/radii.d.ts",
        "default": "./lib/module/radii.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/radii.d.ts",
        "default": "./lib/commonjs/radii.js"
      }
    },
    "./shadows": {
      "react-native": "./src/shadows.ts",
      "import": {
        "types": "./lib/typescript/module/shadows.d.ts",
        "default": "./lib/module/shadows.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/shadows.d.ts",
        "default": "./lib/commonjs/shadows.js"
      }
    },
    "./motion": {
      "react-native": "./src/motion.ts",
      "import": {
        "types": "./lib/typescript/module/motion.d.ts",
        "default": "./lib/module/motion.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/motion.d.ts",
        "default": "./lib/commonjs/motion.js"
      }
    },
    "./breakpoints": {
      "react-native": "./src/breakpoints.ts",
      "import": {
        "types": "./lib/typescript/module/breakpoints.d.ts",
        "default": "./lib/module/breakpoints.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/breakpoints.d.ts",
        "default": "./lib/commonjs/breakpoints.js"
      }
    },
    "./z-index": {
      "react-native": "./src/z-index.ts",
      "import": {
        "types": "./lib/typescript/module/z-index.d.ts",
        "default": "./lib/module/z-index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/z-index.d.ts",
        "default": "./lib/commonjs/z-index.js"
      }
    },
    "./density": {
      "react-native": "./src/density.ts",
      "import": {
        "types": "./lib/typescript/module/density.d.ts",
        "default": "./lib/module/density.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/density.d.ts",
        "default": "./lib/commonjs/density.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "clean": "rm -rf lib .turbo"
  },
  "peerDependencies": {
    "react-native": ">=0.83.0"
  },
  "devDependencies": {
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.41.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
