{
  "name": "@mindees/tokens",
  "version": "0.0.1",
  "description": "Design tokens for MindeesUI — colour, typography, spacing, radii, shadows, motion, breakpoints, z-index, density.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./color": {
      "types": "./lib/typescript/src/color.d.ts",
      "react-native": "./src/color.ts",
      "import": "./lib/module/color.js",
      "require": "./lib/commonjs/color.js"
    },
    "./typography": {
      "types": "./lib/typescript/src/typography.d.ts",
      "react-native": "./src/typography.ts",
      "import": "./lib/module/typography.js",
      "require": "./lib/commonjs/typography.js"
    },
    "./spacing": {
      "types": "./lib/typescript/src/spacing.d.ts",
      "react-native": "./src/spacing.ts",
      "import": "./lib/module/spacing.js",
      "require": "./lib/commonjs/spacing.js"
    },
    "./radii": {
      "types": "./lib/typescript/src/radii.d.ts",
      "react-native": "./src/radii.ts",
      "import": "./lib/module/radii.js",
      "require": "./lib/commonjs/radii.js"
    },
    "./shadows": {
      "types": "./lib/typescript/src/shadows.d.ts",
      "react-native": "./src/shadows.ts",
      "import": "./lib/module/shadows.js",
      "require": "./lib/commonjs/shadows.js"
    },
    "./motion": {
      "types": "./lib/typescript/src/motion.d.ts",
      "react-native": "./src/motion.ts",
      "import": "./lib/module/motion.js",
      "require": "./lib/commonjs/motion.js"
    },
    "./breakpoints": {
      "types": "./lib/typescript/src/breakpoints.d.ts",
      "react-native": "./src/breakpoints.ts",
      "import": "./lib/module/breakpoints.js",
      "require": "./lib/commonjs/breakpoints.js"
    },
    "./z-index": {
      "types": "./lib/typescript/src/z-index.d.ts",
      "react-native": "./src/z-index.ts",
      "import": "./lib/module/z-index.js",
      "require": "./lib/commonjs/z-index.js"
    },
    "./density": {
      "types": "./lib/typescript/src/density.d.ts",
      "react-native": "./src/density.ts",
      "import": "./lib/module/density.js",
      "require": "./lib/commonjs/density.js"
    }
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf lib .turbo"
  },
  "devDependencies": {
    "react-native-builder-bob": "^0.41.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      ["commonjs", { "esm": true }],
      ["module", { "esm": true }],
      ["typescript", { "project": "tsconfig.build.json", "esm": true }]
    ]
  }
}
